{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "terraform-provider"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ghcr.io/external-secrets/charts/external-secrets",
        "ghcr.io/prometheus-community/charts/kube-prometheus-stack"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    }
  ],
  "flux": {
    "managerFilePatterns": [
      "/^k8s/.+\\.ya?ml$/"
    ]
  },
  "automergeType": "branch",
  "ignoreTests": true
}
